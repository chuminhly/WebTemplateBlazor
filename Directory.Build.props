<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Version chung cho moi goi NuGet cua bo template -->
    <Version>1.0.0</Version>
    <Authors>chuminhly</Authors>
    <Company>WebTemplate</Company>
    <RepositoryUrl>https://github.com/chuminhly/WebTemplateBlazor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/chuminhly/WebTemplateBlazor</PackageProjectUrl>

    <!-- Doi version DevExpress cho toan bo solution tai day -->
    <DevExpressVersion>26.1.6</DevExpressVersion>
  </PropertyGroup>
</Project>
