<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Feed chua goi WebTemplate.*. Doi thanh feed noi bo neu cong ty dung feed rieng. -->
    <add key="webtemplate" value="https://nuget.pkg.github.com/chuminhly/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="webtemplate">
      <package pattern="WebTemplate.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
