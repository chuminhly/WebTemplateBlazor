<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>WebTemplate.Core</RootNamespace>
    <PackageId>WebTemplate.Core</PackageId>
    <Description>Layout, theme, menu, mau trang va component dung chung cho ung dung Blazor (.NET 10). Khong phu thuoc DevExpress.</Description>
    <PackageTags>blazor;template;theme;layout</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
