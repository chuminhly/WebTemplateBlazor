@* Mot cap "nhan: gia tri" trong the thong tin. Dat trong <div class="wt-props">. *@
<div>
    <div class="wt-prop-label">@Label</div>
    <div class="wt-prop-value">@if (ChildContent is not null) { @ChildContent } else { @(string.IsNullOrEmpty(Value) ? "—" : Value) }</div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
