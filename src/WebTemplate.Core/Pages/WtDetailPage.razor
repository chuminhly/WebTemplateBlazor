@*
    Mau trang chi tiet ban ghi: tieu de + trang thai, the thong tin chinh, noi dung dang tab, cot phu ben phai.
*@
<div class="wt-page">
    <WtPageHeader Title="@Title" Subtitle="@Subtitle" BackHref="@BackHref" Actions="Actions" TitleSuffix="Status" BreadcrumbCurrent="@Title" />

    @if (Summary is not null)
    {
        <div class="wt-card"><div class="wt-card-body">@Summary</div></div>
    }

    <div class="@(Side is not null ? "wt-dashboard-layout" : "wt-stack")">
        <div class="wt-card"><div class="wt-card-body">@ChildContent</div></div>
        @if (Side is not null)
        {
            <div class="wt-stack">@Side</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BackHref { get; set; }
    /// <summary>Nhan trang thai canh tieu de.</summary>
    [Parameter] public RenderFragment? Status { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    /// <summary>The tom tat dau trang, thuong dung <c>wt-props</c> de liet ke thuoc tinh.</summary>
    [Parameter] public RenderFragment? Summary { get; set; }
    /// <summary>Noi dung chinh, thuong la WtTabs.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Cot phu ben phai (lich su, ghi chu...).</summary>
    [Parameter] public RenderFragment? Side { get; set; }
}
